# ── Required Configuration ─────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# AWS Region for Bedrock (required)
AWS_REGION=us-east-1

# Bedrock model ID (required)
# See: https://docs.aws.amazon.com/bedrock/latest/userguide/model-ids.html
BEDROCK_MODEL=anthropic.claude-3-haiku-20240307-v1:0

# ── AWS Credentials ───────────────────────────────────────────────────
# Uses the standard boto3 credential chain:
#   - Environment variables (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_SESSION_TOKEN)
#   - Shared credentials (~/.aws/credentials)
#   - AWS SSO / Named profiles (AWS_PROFILE)
#   - IAM instance/container roles
#
# Uncomment below if you want to set credentials directly:
# AWS_ACCESS_KEY_ID=your-key-here
# AWS_SECRET_ACCESS_KEY=your-secret-here
# AWS_SESSION_TOKEN=your-token-here
# AWS_PROFILE=your-profile-name
